# External artifacts and model/code checkouts. Keep real values outside Git.
MUSEUMLIVE_10FPS_RUN_ROOT=/path/to/external/10fps-run
MUSEUMLIVE_WORK_ROOT=/path/to/external/work
MUSEUMLIVE_RELEASE_ROOT=/path/to/MuseumLive-Bench-450-Full
MUSEUMLIVE_TASKS_FILE=/path/to/tasks_final450.json
MUSEUMLIVE_BLIND_TASKS_FILE=/path/to/tasks_blind.json
MUSEUMLIVE_RUBRIC_FILE=/path/to/frozen/rubric.json
MINICPM_MODEL_PATH=/path/to/MiniCPM-o-4_5
VENUS_MODEL_PATH=/path/to/Realtime-Venus-Omni
GANDER_CODE_ROOT=/path/to/Omni-Interaction-Agent/minicpm_ft
GANDER_THINKER_PATH=/path/to/Gander/thinker
MOSS_MODEL_PATH=/path/to/MOSS-VL-Realtime
MOSS_ANNOTATION_ROOTS=/path/to/annotations_audio:/path/to/annotations_audio_316
MUSEUMLIVE_EVAL_PYLIB=/path/to/omni_eval/pylib
MUSEUMLIVE_TTS_INDEX_ROOT=/path/to/omni_eval
MOSS_PYLIB_ROOT=/path/to/model_compare/pylib_moss
EVAL_GPUS=2,3,4,5,6,7
VISUAL_FPS=10
# Generation-only inputs. These are not required to evaluate the frozen tasks.
MUSEUMLIVE_VIDEO_SELECTION=/path/to/selected_videos.json
MUSEUMLIVE_25FPS_ROOT=/path/to/external/frozen_25fps
MUSEUMLIVE_AUDIO_ANNOTATION_ROOT=/path/to/external/audio_annotations
MUSEUMLIVE_MEDIA50_ROOT=/path/to/external/media50
MUSEUMLIVE_MEDIA316_MANIFEST=/path/to/external/media316_manifest.json
MUSEUMLIVE_GAPS316=/path/to/external/gap_seconds_316.json
MUSEUMLIVE_QA50_ROOT=/path/to/external/museumlive_50_qa
MUSEUMLIVE_WINDOWS50=/path/to/external/windows50.jsonl
MUSEUMLIVE_VISUAL50_ARCHIVE=/path/to/external/visual50.zip
MUSEUMLIVE_MEDIA50_PREFLIGHT=/path/to/external/media50_preflight.json
MUSEUMLIVE_ANNOTATIONS50A=/path/to/external/annotations_with_audio
MUSEUMLIVE_ANNOTATIONS316A=/path/to/external/annotations_with_audio_316
QA_RUNS=/path/to/external/qa_generation_runs
QA_GENERATION_MODEL=qwen/qwen3.8-omni-flash
# Set OPENROUTER_API_KEY only in the shell/session; never add it to this file.
